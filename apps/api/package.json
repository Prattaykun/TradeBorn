{
  "name": "@TradeBorn/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@langchain/core": "^0.3.42",
    "@langchain/google-genai": "^0.2.17",
    "@langchain/langgraph": "^0.2.49",
    "@langchain/openai": "^0.4.4",
    "@prisma/client": "^6.4.1",
    "@TradeBorn/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "langchain": "^0.3.19",
    "minisearch": "^7.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
