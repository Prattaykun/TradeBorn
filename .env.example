# Neon Postgres (required)
# Pooled connection for runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"
# Direct / unpooled for Prisma migrate (host WITHOUT -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# LLM: openai | groq | google | gemini | ollama
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
# Optional comma list tried before the built-in free-tier Gemini text cascade.
# Built-in fallbacks (google/gemini only): gemini-3.8-flash, gemini-3.7-flash,
# gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite,
# gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
# LLM_FALLBACK_MODELS=
# Groq: LLM_PROVIDER=groq LLM_MODEL=llama-3.3-70b-versatile
# Ollama: LLM_PROVIDER=ollama LLM_MODEL=llama3.2 OLLAMA_BASE_URL=http://127.0.0.1:11434

# Embeddings: openai | google | gemini | ollama | none
EMBEDDING_PROVIDER=google
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Search (optional / paid). Leave blank — free path: DuckDuckGo → Wikipedia → MiniSearch.
# Brave is prepaid credits only (no free tier). Set BRAVE_SEARCH_API_KEY only if you pay for it.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
